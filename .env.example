# Your existing, self-managed Navidrome instance
NAVIDROME_URL=http://navidrome.local:4533
NAVIDROME_USERNAME=youruser
NAVIDROME_PASSWORD=yourpassword

# Icecast credentials - change all three
ICECAST_SOURCE_PASSWORD=change_me_source
ICECAST_RELAY_PASSWORD=change_me_relay
ICECAST_ADMIN_PASSWORD=change_me_admin
ICECAST_HOSTNAME=your.server.hostname

# Must use the same browser hostname as the app so its session cookie reaches Icecast.
# For public HTTPS deploy use https://your.public.hostname/radio.mp3.
ICECAST_STREAM_URL=http://localhost:6491/radio.mp3

# The browser origin the app is served from (scheme://host[:port], no path), set
# ONLY when it differs from the Icecast origin above - i.e. local dev, where the
# app runs on :8080 and Icecast on :6491. It makes Icecast send credentialed-CORS
# headers for the stream so the in-page audio visualizer can read it. Leave blank
# for a same-origin deploy (app and /radio.mp3 on one host); it's not needed there.
# ICECAST_CORS_ORIGIN=http://localhost:8080

# Port Icecast listens on (and publishes to the host). Defaults to 6491 if unset -
# only worth setting if that collides with something else on your machine.
# ICECAST_PORT=6491

# MP3 bitrate for the broadcast, in kbps. Every listener costs this much upload:
# 320 is ~144 MB/hour each (~3.8 Mbps for a dozen), 192 is ~86 MB/hour (~2.3 Mbps).
# Drop it if the connection struggles.
STREAM_BITRATE=320

# Only read when running the app directly on the host (e.g. `uvicorn main:app --reload`)
# for hot-reload dev. Ignored inside docker compose, which hardcodes these to reach
# the liquidsoap container by its service name instead.
LIQUIDSOAP_HOST=localhost
LIQUIDSOAP_PORT=1234

# Where the room's queues/rotation/chat are mirrored so a restart doesn't wipe them.
# Defaults to room-state.json in the working directory. Docker overrides this to a
# named volume - keep the two apart, since two app instances sharing one state file
# would clobber each other.
# STATE_PATH=room-state.json

# Set this so `task invite` can print a ready-to-share full URL.
APP_PUBLIC_URL=http://localhost:8080

# One shared secret for the single universal invite link everyone uses to join.
# Leave blank and run `task invite` once - it'll generate one and save it here.
INVITE_TOKEN=

# Dedicated read-only token for Homepage: Authorization: Bearer <token>.
# Only grants access to /api/stats; empty disables access.
STATS_API_TOKEN=

# --- DJ breaks -------------------------------------------------------------------
# Optional. A short AI-voiced line between songs (joke / fun fact about the last
# track), toggled on/off from the UI by anyone in the room. Entirely inert unless
# OPENROUTER_API_KEY is set - the toggle still shows, breaks just never generate.
#
# The script is written via OpenRouter (openrouter.ai); the voice is a local Piper
# container (no key, no per-use cost). Clips land in ./dj-break-cache, which the
# liquidsoap container mounts at /clips and plays by path.
#
# Privacy note: while breaks are on, each one sends the two track titles/artists PLUS
# recent chat lines and display names and a short join/leave log to the OpenRouter
# model, so it can react to the room. Leave the key blank to keep all of that local.
OPENROUTER_API_KEY=
# Comma-separated. The app rotates through them and logs which one wrote each break,
# so you can compare models on this task.
OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku
# OPENROUTER_URL=https://openrouter.ai/api/v1
# PIPER_URL=http://localhost:5000
# PIPER_VOICE=en_US-lessac-medium
# A break every Nth song gap (1 = every gap).
# DJ_BREAK_EVERY_N=1
# DJ_BREAK_MAX_WORDS=40
# Optional prompt override. Gitignored - put names / inside jokes here.
# Copy dj-break-prompt.txt.example to dj-break-prompt.txt.
# DJ_BREAK_PROMPT_FILE=dj-break-prompt.txt
