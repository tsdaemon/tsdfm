# For `task deploy`. Layered on top of .env (go-task merges dotenv files, with
# this one winning on overlap) - so you only need to set what's actually
# different for the remote NAS, not copy every variable from .env.example
# again. See docs/architecture.md.

# LAN-only hostname Traefik routes to the app (web_local entrypoint, plain
# HTTP, no cert) - see the traefik role at https://github.com/tsdaemon/theseus.
# Public HTTPS exposure is handled outside this repo (e.g. a Cloudflare
# Tunnel/proxy in front), not by Traefik here - see docs/architecture.md.
APP_HOSTNAME=tsdfm.yourdomain

# Hostname for LAN-only Traefik route to the app (web_local entrypoint, plain HTTP, no cert) - see the traefik role at
APP_HOSTNAME_LOCAL=tsdfm.yourlocaldomain

# The URL friends actually use - whatever your public-facing setup (Cloudflare
# etc.) exposes, NOT necessarily the same host as APP_HOSTNAME above. Only
# used so `task deploy:invite` can print a ready-to-share full link.
APP_PUBLIC_URL=https://tsdfm.yourdomain.com
APP_PORT=6490

# Public URL friends' browsers will stream from - the NAS's own address, since
# Icecast is published directly (not routed through Traefik). Only needed here
# if it differs from .env (e.g. .env points at a LAN IP for local testing).
ICECAST_STREAM_URL=http://your.server.hostname:6491/radio.mp3
ICECAST_HOSTNAME=your.server.hostname
ICECAST_PORT=6491

# Only needed here if the NAS should use a different Navidrome, different
# Icecast passwords, a different STREAM_BITRATE, etc. than local .env.
# NAVIDROME_URL=http://navidrome.local:4533
# NAVIDROME_USERNAME=youruser
# NAVIDROME_PASSWORD=yourpassword
# ICECAST_SOURCE_PASSWORD=change_me_source
# ICECAST_RELAY_PASSWORD=change_me_relay
# ICECAST_ADMIN_PASSWORD=change_me_admin
# STREAM_BITRATE=320

# A separate key from .env's INVITE_TOKEN on purpose (see docker-compose.deploy.yml) -
# the deployed room always gets its own invite link, and can never accidentally
# fall back to your local test room's token. Leave blank and run
# `task deploy:invite` once - it'll generate one and save it here.
DEPLOY_INVITE_TOKEN=
